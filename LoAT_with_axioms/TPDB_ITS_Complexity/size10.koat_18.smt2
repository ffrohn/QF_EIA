(assert (= (+ (* i3 (- 1)) it3) 0))
(assert (= (+ (* i4 (- 1)) it4) 0))
(assert (= (+ (* i5 (- 1)) it5) 0))
(assert (= (+ (* i6 (- 1)) it6) 0))
(assert (= (+ it7 (* i7 (- 1))) 0))
(assert (let ((a!1 (> (+ (+ it3 (* it120 (- 2))) 1) 0))
      (a!2 (> (+ (+ it3 (* it120 (- 2))) 2) 0)))
  (and (>= (+ (* it1 (- 1)) 2) 0)
       a!1
       a!2
       (>= (+ it1 (- 2)) 0)
       (>= (+ it120 (- 1)) 0))))
(assert (= (+ (* it1 (- 1)) it121) 0))
(assert (= (+ (* it2 (- 1)) it122 (* it120 (- 2))) 0))
(assert (= (+ (* it3 (- 1)) it123 (* it120 2)) 0))
(assert (= (+ (+ 0 it124) (* (+ 0 it4) (iexp (- 1) it120) (+ 0 (- 1))))
   (+ 0 0)))
(assert (= (+ (+ 0 it125) (* (+ 0 it5) (iexp (- 1) it120) (+ 0 (- 1))))
   (+ 0 0)))
(assert (= (+ (* (iexp it3 2) (+ 0 it120) (+ 0 (- 6)))
      (* (iexp it120 2) (+ 0 6))
      (* (iexp it120 3) (+ 0 (- 8)))
      (* (+ 0 it3) (iexp it120 2) (+ 0 12))
      (+ 0 (* it3 it120 (- 6)))
      (+ 0 (* it6 (- 3)))
      (+ 0 (* it126 3))
      (+ 0 (* it120 (- 1))))
   (+ 0 0)))
