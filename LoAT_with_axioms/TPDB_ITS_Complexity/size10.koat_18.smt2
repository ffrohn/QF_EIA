(assert (let ((a!1 (> (+ (+ it127 (* it81 (- 2))) 1) 0))
      (a!2 (> (+ (+ it127 (* it81 (- 2))) 2) 0)))
  (and (> (+ it127 (- 1)) 0)
       (> it127 0)
       a!1
       (>= (+ (* it121 (- 1)) 2) 0)
       (>= (+ it81 (- 1)) 0)
       (>= (+ it121 (- 2)) 0)
       a!2)))
(check-sat)
