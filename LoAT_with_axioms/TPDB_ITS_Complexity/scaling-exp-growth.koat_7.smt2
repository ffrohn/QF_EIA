(set-logic ALL)
(declare-fun iexp (Int Int) Int)
(assert (forall ((b Int)) (= (iexp b 0) 1)))
(assert (forall ((e Int)) (= (iexp 1 e) 1)))
(assert (forall ((e Int)) (=> (= (mod e 2) 0) (= (iexp (- 1) e) 1))))
(assert (forall ((e Int)) (=> (= (mod e 2) 1) (= (iexp (- 1) e) (- 1)))))
(assert (forall ((b Int) (e Int)) (=> (and (or (< b (- 1)) (= b 0) (> b 1)) (< e (- 1))) (= (iexp b e) 0))))
(assert (forall ((b Int) (e Int)) (=> (> e 0) (= (iexp b e) (* b (iexp b (- e 1)))))))
(declare-fun i1 () Int)
(declare-fun it1 () Int)
(declare-fun it2 () Int)
(declare-fun i2 () Int)
(declare-fun it3 () Int)
(declare-fun i3 () Int)
(declare-fun it4 () Int)
(declare-fun i4 () Int)
(declare-fun it10 () Int)
(declare-fun it11 () Int)
(declare-fun it12 () Int)
(declare-fun it13 () Int)
(declare-fun it21 () Int)
(declare-fun it22 () Int)
(declare-fun it23 () Int)
(declare-fun it24 () Int)
(declare-fun it25 () Int)
(declare-fun it26 () Int)
(declare-fun it27 () Int)
(declare-fun it28 () Int)
(assert (= (+ i1 (- 1)) 0))
(assert (= (+ it1 (- 2)) 0))
(assert (= (+ (* i2 (- 1)) it2 (- 1)) 0))
(assert (= (+ (* i3 (- 1)) it3) 0))
(assert (= (+ (* i4 (- 1)) it4) 0))
(assert (and (>= (+ it4 (- 1)) 0)
     (>= (+ (* it1 (- 1)) 2) 0)
     (>= (+ it1 (- 2)) 0)
     (> 1 0)))
(assert (= (+ (* it1 (- 1)) it10) 0))
(assert (= (+ it11 (* it4 (- 1)) (* it2 (- 1))) 0))
(assert (= (+ (* (iexp 2 it4) (+ 0 it3) (+ 0 (- 1))) (+ 0 it12)) (+ 0 0)))
(assert (= it13 0))
(assert (and (>= (* it13 (- 1)) 0) (= (+ it10 (- 2)) 0)))
(assert (= (+ it21 (- 3)) 0))
(assert (= (+ it22 (* it11 (- 1)) (- 1)) 0))
(assert (= (+ it23 (* it12 (- 1))) 0))
(assert (= (+ it24 (* it13 (- 1))) 0))
(assert (and (= (+ it21 (- 3)) 0) (> it23 0)))
(assert (= (+ it25 (- 3)) 0))
(assert (= (+ (* it22 (- 1)) it26 (- 1)) 0))
(assert (= (+ it27 (* it23 (- 1)) 1) 0))
(assert (= (+ it28 (* it24 (- 1))) 0))
(check-sat)
