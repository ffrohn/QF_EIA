(assert (= (+ it1 (- 2)) 0))
(assert (= (+ it2 (* i2 (- 1)) (- 1)) 0))
(assert (= (+ it3 (* i3 (- 1))) 0))
(assert (= (+ (* i4 (- 1)) it4) 0))
(assert (= (+ it5 (* i5 (- 1))) 0))
(assert (= (+ it6 (* i6 (- 1))) 0))
(assert (let ((a!1 (> (+ (+ (* it92 (- 2)) it3) 1) 0))
      (a!2 (> (+ (+ (* it92 (- 2)) it3) 2) 0)))
  (and (>= (+ it92 (- 1)) 0)
       (>= (+ (* it1 (- 1)) 2) 0)
       a!1
       (>= (+ it1 (- 2)) 0)
       a!2)))
(assert (= (+ it1063 (* it1 (- 1))) 0))
(assert (= (+ it1064 (* it2 (- 1)) (* it92 (- 2))) 0))
(assert (= (+ (* it92 2) it1065 (* it3 (- 1))) 0))
(assert (= (+ (* (iexp (- 1) it92) (+ 0 it4) (+ 0 (- 1))) (+ 0 it1066))
   (+ 0 0)))
(assert (= (+ (+ 0 it1067) (* (iexp (- 1) it92) (+ 0 it5) (+ 0 (- 1))))
   (+ 0 0)))
(assert (= (+ (* (+ 0 it92) (iexp it3 2) (+ 0 (- 6)))
      (+ 0 (* it92 it3 (- 6)))
      (* (iexp it92 2) (+ 0 6))
      (+ 0 (* it92 (- 1)))
      (* (iexp it92 3) (+ 0 (- 8)))
      (+ 0 (* it6 (- 3)))
      (+ 0 (* it1068 3))
      (* (iexp it92 2) (+ 0 it3) (+ 0 12)))
   (+ 0 0)))
(assert (let ((a!1 (> (+ (+ it1065 (* it13 (- 2))) 1) 0))
      (a!2 (> (+ (+ it1065 (* it13 (- 2))) 2) 0)))
  (and (>= (+ (* it1063 (- 1)) 2) 0)
       (>= (+ it13 (- 1)) 0)
       a!1
       a!2
       (>= (+ it1063 (- 2)) 0))))
(assert (= (+ it1083 (* it1063 (- 1))) 0))
(assert (= (+ (* it1064 (- 1)) it1084 (* it13 (- 2))) 0))
(assert (= (+ (* it1065 (- 1)) (* it13 2) it1085) 0))
(assert (= (+ (+ 0 it1086) (* (iexp (- 1) it13) (+ 0 it1066) (+ 0 (- 1))))
   (+ 0 0)))
(assert (= (+ (+ 0 it1087) (* (+ 0 it1067) (iexp (- 1) it13) (+ 0 (- 1))))
   (+ 0 0)))
(assert (= (+ (* (iexp it13 3) (+ 0 (- 8)))
      (* (iexp it1065 2) (+ 0 it13) (+ 0 (- 6)))
      (* (iexp it13 2) (+ 0 6))
      (+ 0 (* it1068 (- 3)))
      (* (+ 0 it1065) (iexp it13 2) (+ 0 12))
      (+ 0 (* it1065 it13 (- 6)))
      (+ 0 (* it13 (- 1)))
      (+ 0 (* it1088 3)))
   (+ 0 0)))
(assert (and (>= (+ it1083 (- 2)) 0)
     (> (+ it1085 (- 1)) 0)
     (>= (+ (* it1083 (- 1)) 2) 0)
     (> it1085 0)
     (= 2 0)))
(check-sat)
