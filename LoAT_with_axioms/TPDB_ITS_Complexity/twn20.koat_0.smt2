(set-logic ALL)
(declare-fun iexp (Int Int) Int)
(assert (forall ((b Int)) (= (iexp b 0) 1)))
(assert (forall ((e Int)) (= (iexp 1 e) 1)))
(assert (forall ((e Int)) (=> (= (mod e 2) 0) (= (iexp (- 1) e) 1))))
(assert (forall ((e Int)) (=> (= (mod e 2) 1) (= (iexp (- 1) e) (- 1)))))
(assert (forall ((b Int) (e Int)) (=> (and (or (< b (- 1)) (= b 0) (> b 1)) (< e (- 1))) (= (iexp b e) 0))))
(assert (forall ((b Int) (e Int)) (=> (> e 0) (= (iexp b e) (* b (iexp b (- e 1)))))))
(declare-fun i1 () Int)
(declare-fun i5 () Int)
(declare-fun it1 () Int)
(declare-fun it2 () Int)
(declare-fun i2 () Int)
(declare-fun i3 () Int)
(declare-fun it3 () Int)
(declare-fun it4 () Int)
(declare-fun i4 () Int)
(declare-fun it5 () Int)
(declare-fun it11 () Int)
(assert (and (> i5 0) (= (+ i1 (- 1)) 0)))
(assert (= (+ it1 (- 2)) 0))
(assert (= (+ (* i2 (- 1)) it2 (- 1)) 0))
(assert (= (+ it3 (* i3 (- 1))) 0))
(assert (= (+ (* i4 (- 1)) it4) 0))
(assert (= (+ (* i5 (- 1)) it5) 0))
(assert (let ((a!1 (> (+ (* (iexp it3 2) (+ 0 (- 1)))
                 (+ 0 it4)
                 (* (iexp it5 5) (+ 0 (- 1))))
              (+ 0 0)))
      (a!2 (* (iexp (iexp 4 (+ it11 (- 1))) (+ 0 2)) (iexp it3 2) (+ 0 (- 1)))))
(let ((a!3 (+ a!2
              (iexp it5 3)
              (* (+ 0 it4) (iexp 9 (+ it11 (- 1))))
              (* (iexp it5 5) (+ 0 (- 1)))
              (* (iexp 9 (+ it11 (- 1))) (iexp it5 3) (+ 0 (- 1))))))
  (and (>= (+ it1 (- 2)) 0)
       a!1
       (>= (+ (* it1 (- 1)) 2) 0)
       (> a!3 (+ 0 0))
       (> it3 0)
       (>= (+ it11 (- 1)) 0)))))
(check-sat)
