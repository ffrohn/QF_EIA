      (a!3 (* (* (iexp 9 (+ it200 (- 1))) (iexp it620 3)) (+ 0 (- 3))))
      (a!5 (* (* (iexp 9 (+ it200 (- 1))) (iexp it620 3)) (+ 0 (- 1))))
      (a!7 (> (+ (+ 0 it619)
                 (* (iexp it620 5) (+ 0 (- 1)))
                 (* (iexp it618 2) (+ 0 (- 1))))
              (+ 0 0))))
(let ((a!4 (> (+ (* a!1 (+ 0 (- 4)))
                 (* (iexp it620 5) (+ 0 (- 1)))
                 a!2
                 a!3
                 (iexp it620 3))
              (+ 0 0)))
      (a!6 (+ (* a!1 (+ 0 (- 1)))
              (* (iexp it620 5) (+ 0 (- 1)))
              (* (+ 0 it619) (iexp 9 (+ it200 (- 1))))
              a!5
              (iexp it620 3))))
  (and a!4
       (>= (+ (* it615 (- 1)) 3) 0)
       (>= (+ it615 (- 3)) 0)
       (> a!6 (+ 0 0))
       (> (* it618 (- 1)) 0)
       (> (* it618 (- 2)) 0)
       (>= (+ it200 (- 1)) 0)
