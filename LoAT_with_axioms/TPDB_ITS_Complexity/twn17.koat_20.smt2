(assert (let ((a!1 (< (+ (iexp it610 2) (+ 0 (* it611 (- 1))) (iexp it612 5)) (+ 0 0))))
  (and (= (+ it607 (- 3)) 0) (> it610 0) a!1)))
(assert (= (+ it615 (- 3)) 0))
(assert (= (+ it616 (* it608 (- 1)) (- 1)) 0))
(assert (= (+ it617 (* it609 (- 1))) 0))
