(set-logic ALL)
(declare-fun iexp (Int Int) Int)
(assert (forall ((b Int)) (= (iexp b 0) 1)))
(assert (forall ((e Int)) (= (iexp 1 e) 1)))
(assert (forall ((e Int)) (=> (= (mod e 2) 0) (= (iexp (- 1) e) 1))))
(assert (forall ((e Int)) (=> (= (mod e 2) 1) (= (iexp (- 1) e) (- 1)))))
(assert (forall ((b Int) (e Int)) (=> (and (or (< b (- 1)) (= b 0) (> b 1)) (< e (- 1))) (= (iexp b e) 0))))
(assert (forall ((b Int) (e Int)) (=> (> e 0) (= (iexp b e) (* b (iexp b (- e 1)))))))
(declare-fun i1 () Int)
(declare-fun it1 () Int)
(declare-fun it2 () Int)
(declare-fun i2 () Int)
(declare-fun it3 () Int)
(declare-fun i3 () Int)
(declare-fun it4 () Int)
(declare-fun i4 () Int)
(declare-fun it9 () Int)
(declare-fun it12 () Int)
(declare-fun it13 () Int)
(declare-fun it14 () Int)
(declare-fun it15 () Int)
(assert (= (+ i1 (- 1)) 0))
(assert (= (+ it1 (- 2)) 0))
(assert (= (+ (* i2 (- 1)) it2 (- 1)) 0))
(assert (= (+ (* i3 (- 1)) it3) 0))
(assert (= (+ (* i4 (- 1)) it4) 0))
(assert (let ((a!1 (+ (* (+ 0 it4) (iexp 3 (+ it9 (- 1))) (+ 0 (- 1)))
              (* (iexp 2 (+ it9 (- 1))) (+ 0 it3)))))
  (and (>= (+ it3 (- 1)) 0)
       (>= (+ (* it1 (- 1)) 2) 0)
       (>= (+ it4 (- 1)) 0)
       (>= (+ (* it4 4) (* it3 (- 1))) 0)
       (>= a!1 (+ 0 0))
       (>= (+ it1 (- 2)) 0)
       (>= (+ it9 (- 1)) 0))))
(assert (= (+ (* it1 (- 1)) it12) 0))
(assert (= (+ (* it2 (- 1)) (* it9 (- 1)) it13) 0))
(assert (= (+ (* (iexp 2 it9) (+ 0 it3) (+ 0 (- 1))) (+ 0 it14)) (+ 0 0)))
(assert (= (+ (+ 0 it15) (* (+ 0 it4) (iexp 3 it9) (+ 0 (- 1)))) (+ 0 0)))
(check-sat)
