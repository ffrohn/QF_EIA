(assert (= (+ it204 (- 3)) 0))
(assert (= (+ it205 (* it2 (- 1)) (- 1)) 0))
(assert (= (+ it206 (* it3 (- 1))) 0))
(assert (= (+ it207 (* it3 (- 1))) 0))
(assert (= (+ (* it7 (- 1)) it208) 0))
(assert (= (+ (* it6 (- 1)) it209) 0))
(assert (= (+ it210 (* it7 (- 1))) 0))
(assert (let ((a!1 (* (* (iexp 9 (+ it109 (- 1))) (iexp it209 3)) (+ 0 (- 3))))
      (a!2 (* (iexp (iexp 4 (+ it109 (- 1))) (+ 0 2)) (iexp it207 2)))
      (a!3 (* (* (+ 0 it208) (iexp 9 (+ it109 (- 1)))) (+ 0 3)))
      (a!5 (* (* (iexp 9 (+ it109 (- 1))) (iexp it209 3)) (+ 0 (- 1))))
      (a!7 (> (+ (* (iexp it207 2) (+ 0 (- 1)))
                 (+ 0 it208)
                 (* (iexp it209 5) (+ 0 (- 1))))
              (+ 0 0))))
(let ((a!4 (> (+ (iexp it209 3)
                 a!1
                 (* a!2 (+ 0 (- 4)))
                 (* (iexp it209 5) (+ 0 (- 1)))
                 a!3)
              (+ 0 0)))
      (a!6 (+ (iexp it209 3)
              a!5
              (* a!2 (+ 0 (- 1)))
              (* (iexp it209 5) (+ 0 (- 1)))
              (* (+ 0 it208) (iexp 9 (+ it109 (- 1)))))))
  (and (> it207 0)
       (>= (+ it204 (- 3)) 0)
       (>= (+ (* it204 (- 1)) 3) 0)
       a!4
       (> (* it207 2) 0)
       (> a!6 (+ 0 0))
       a!7
       (>= (+ it109 (- 1)) 0)))))
