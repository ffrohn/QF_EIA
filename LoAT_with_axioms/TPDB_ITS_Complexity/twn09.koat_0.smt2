(assert (let ((a!1 (* (iexp it9 2) (iexp (iexp 2 (+ it16 (- 1))) (+ 0 2)) (+ 0 132))))
(let ((a!2 (+ (* (+ 0 it9) (iexp 5 (+ it16 (- 1))) (iexp it10 3) (+ 0 176))
