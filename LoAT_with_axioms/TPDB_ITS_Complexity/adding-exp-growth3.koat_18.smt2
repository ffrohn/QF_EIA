(set-logic ALL)
(declare-fun iexp (Int Int) Int)
(assert (forall ((b Int)) (= (iexp b 0) 1)))
(assert (forall ((e Int)) (= (iexp 1 e) 1)))
(assert (forall ((e Int)) (=> (= (mod e 2) 0) (= (iexp (- 1) e) 1))))
(assert (forall ((e Int)) (=> (= (mod e 2) 1) (= (iexp (- 1) e) (- 1)))))
(assert (forall ((b Int) (e Int)) (=> (and (or (< b (- 1)) (= b 0) (> b 1)) (< e (- 1))) (= (iexp b e) 0))))
(assert (forall ((b Int) (e Int)) (=> (> e 0) (= (iexp b e) (* b (iexp b (- e 1)))))))
(declare-fun i1 () Int)
(declare-fun it1 () Int)
(declare-fun it2 () Int)
(declare-fun i2 () Int)
(declare-fun i3 () Int)
(declare-fun it3 () Int)
(declare-fun it4 () Int)
(declare-fun it5 () Int)
(declare-fun it12 () Int)
(declare-fun it13 () Int)
(declare-fun it14 () Int)
(declare-fun it15 () Int)
(declare-fun it16 () Int)
(assert (= (+ i1 (- 1)) 0))
(assert (= (+ it1 (- 2)) 0))
(assert (= (+ (* i2 (- 1)) it2 (- 1)) 0))
(assert (= (+ it3 (* i3 (- 1))) 0))
(assert (= (+ it4 (- 1)) 0))
(assert (= it5 0))
(assert (and (>= (+ it3 (- 1)) 0)
     (> it3 0)
     (>= (+ it1 (- 2)) 0)
     (>= (+ (* it1 (- 1)) 2) 0)
     (> 1 0)))
(assert (= (+ it12 (* it1 (- 1))) 0))
(assert (= (+ (* it3 (- 2)) it13 (* it2 (- 1))) 0))
(assert (= it14 0))
(assert (= (+ (+ 0 it15) (* (iexp 2 it3) (+ 0 it4) (+ 0 (- 1)))) (+ 0 0)))
(assert (let ((a!1 (+ (* (+ 0 it4) (iexp 2 (+ it3 (- 1))) (+ 0 (- 1)))
              (+ 0 it16))))
  (= a!1 (+ 0 0))))
(check-sat)
