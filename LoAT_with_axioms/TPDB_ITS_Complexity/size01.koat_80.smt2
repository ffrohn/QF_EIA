(assert (= (+ (* it48 it436 (- 2)) it440 (* it2 (- 1)) (* it436 it13 (- 2))) 0))
(assert (= (+ (* it48 it436 2) it441 (* it3 (- 1)) (* it436 it13 2)) 0))
(assert (let ((a!1 (* (iexp (- 1) (+ (* it48 it436) (* it436 it13)))
              (+ 0 it4)
              (+ 0 (- 1)))))
  (= (+ a!1 (+ 0 it442)) (+ 0 0))))
(assert (let ((a!1 (* (+ 0 it5)
              (iexp (- 1) (+ (* it48 it436) (* it436 it13)))
              (+ 0 (- 1)))))
  (= (+ (+ 0 it443) a!1) (+ 0 0))))
(assert (let ((a!1 (+ (* (* (iexp it48 2) (iexp it436 2)) (+ 0 it3) (+ 0 12))
              (+ 0 (* (* it48 it436) (- 1)))
              (* (iexp it436 2) (+ 0 it3) (iexp it13 2) (+ 0 12))
              (* (* (+ 0 it48) (iexp it436 2))
