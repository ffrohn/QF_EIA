              (* it13 (+ it436 (- 1)) (- 2))
              it3))
      (a!3 (> (+ (+ (* it48 (- 2)) it3) 1) 0)))
(let ((a!4 (> (+ (+ a!2 (* it13 (- 2))) 2) 0))
      (a!5 (> (+ (+ a!2 (* it13 (- 2))) 1) 0)))
  (and a!1
       (> (+ a!2 2) 0)
       (>= (+ it1 (- 2)) 0)
       (> (+ a!2 1) 0)
       (>= (+ it13 (- 1)) 0)
       (>= (+ (* it1 (- 1)) 2) 0)
       a!3
       (>= (+ it48 (- 1)) 0)
       a!4
       a!5
       (>= (+ it436 (- 1)) 0)))))
