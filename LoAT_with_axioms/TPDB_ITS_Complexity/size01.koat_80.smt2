                 (+ 0 it13)
                 (+ 0 24))
              (+ 0 (* (* it48 it436) it3 (- 6)))
              (* (iexp it436 2) (iexp it13 2) (+ 0 6))
              (* (+ 0 it48) (iexp it436 3) (iexp it13 2) (+ 0 (- 24)))
              (* (+ 0 it436) (iexp it3 2) (+ 0 it13) (+ 0 (- 6)))
              (* (iexp it436 3) (iexp it13 3) (+ 0 (- 8)))
              (* (+ 0 (* it48 it436)) (iexp it3 2) (+ 0 (- 6)))
              (* (* (+ 0 it48) (iexp it436 2)) (+ 0 it13) (+ 0 12))
              (+ 0 (* it444 3))
              (+ 0 (* it6 (- 3)))
              (* (* (iexp it48 2) (iexp it436 2)) (+ 0 6))
              (+ 0 (* it436 it3 it13 (- 6)))
              (+ 0 (* it436 it13 (- 1)))
              (* (iexp it48 3) (iexp it436 3) (+ 0 (- 8)))
              (* (iexp it48 2) (iexp it436 3) (+ 0 it13) (+ 0 (- 24))))))
