(assert (= (+ it5 (* i5 (- 1))) 0))
(assert (= (+ it6 (* i6 (- 1))) 0))
(assert (let ((a!1 (> (+ (+ (* it48 (- 2)) it3) 2) 0))
      (a!2 (> (+ (+ (* it48 (- 2)) it3) 1) 0)))
  (and (>= (+ it48 (- 1)) 0)
       a!1
       a!2
       (>= (+ (* it1 (- 1)) 2) 0)
       (>= (+ it1 (- 2)) 0))))
(assert (= (+ it838 (* it1 (- 1))) 0))
(assert (= (+ (* it48 (- 2)) (* it2 (- 1)) it839) 0))
(assert (= (+ (* it48 2) (* it3 (- 1)) it840) 0))
(assert (= (+ (+ 0 it841) (* (iexp (- 1) it48) (+ 0 it4) (+ 0 (- 1))))
   (+ 0 0)))
(assert (= (+ (+ 0 it842) (* (+ 0 it5) (iexp (- 1) it48) (+ 0 (- 1))))
   (+ 0 0)))
(assert (= (+ (+ 0 (* it48 (- 1)))
      (* (iexp it48 2) (+ 0 it3) (+ 0 12))
      (+ 0 (* it6 (- 3)))
      (* (iexp it48 2) (+ 0 6))
      (* (+ 0 it48) (iexp it3 2) (+ 0 (- 6)))
      (* (iexp it48 3) (+ 0 (- 8)))
      (+ 0 (* it843 3))
      (+ 0 (* it48 it3 (- 6))))
   (+ 0 0)))
(assert (let ((a!1 (> (+ (+ (* it13 (- 2)) it840) 1) 0))
      (a!2 (> (+ (+ (* it13 (- 2)) it840) 2) 0)))
  (and (>= (+ it13 (- 1)) 0)
       (>= (+ (* it838 (- 1)) 2) 0)
       (>= (+ it838 (- 2)) 0)
       a!1
       a!2)))
(assert (= (+ it858 (* it838 (- 1))) 0))
(assert (= (+ it859 (* it839 (- 1)) (* it13 (- 2))) 0))
(assert (= (+ (* it13 2) it860 (* it840 (- 1))) 0))
(assert (= (+ (+ 0 it861) (* (+ 0 it841) (iexp (- 1) it13) (+ 0 (- 1))))
   (+ 0 0)))
(assert (= (+ (+ 0 it862) (* (+ 0 it842) (iexp (- 1) it13) (+ 0 (- 1))))
   (+ 0 0)))
(assert (= (+ (* (iexp it13 3) (+ 0 (- 8)))
      (* (+ 0 it13) (iexp it840 2) (+ 0 (- 6)))
      (* (iexp it13 2) (+ 0 6))
      (+ 0 (* it13 it840 (- 6)))
      (* (iexp it13 2) (+ 0 it840) (+ 0 12))
      (+ 0 (* it13 (- 1)))
      (+ 0 (* it863 3))
      (+ 0 (* it843 (- 3))))
   (+ 0 0)))
(assert (and (>= (+ it858 (- 2)) 0)
     (> (+ it860 (- 1)) 0)
     (= 2 0)
     (>= (+ (* it858 (- 1)) 2) 0)
     (> it860 0)))
(check-sat)
